NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://root:root@127.0.0.1:3306/market_analysis"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3001"
SESSION_COOKIE_NAME="market_analysis_session"
SESSION_TTL_DAYS="7"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
# Daily analysis is routed through the backend LLM gateway.
LLM_PROVIDER="claude"
CLAUDE_API_KEY="your-claude-api-key"
# Sonnet is the default; raw Claude model IDs also work.
CLAUDE_MODEL="sonnet"
CLAUDE_TIMEOUT_MS="60000"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"
BINANCE_BASE_URL="https://api.binance.com"
TRACKED_SYMBOLS="BTCUSDT,ETHUSDT"
ANALYSIS_TIMEFRAME="4h"
ANALYSIS_CRON="1 0 */4 * * *"
LOG_LEVEL="debug"
MANUAL_ANALYSIS_TRIGGER_ENABLED="false"
# Optional: CoinGecko API key for small-cap radar sync (demo key = free at coingecko.com/api/pricing, higher rate limits)
COINGECKO_API_KEY=""

# --- Bitget live trading (day-trading bot, Phase 2) ---
# Real futures account. API permissions: Trade (ON), Withdraw (OFF). Whitelist the server IP.
# Keep LIVE_TRADING_ENABLED=false until Phase 2 (idempotency + reconciliation) is implemented.
BITGET_API_KEY=""
BITGET_API_SECRET=""
BITGET_API_PASSPHRASE=""
# usdt-futures = real, susdt-futures = demo
BITGET_PRODUCT_TYPE="usdt-futures"
# Leverage for LIVE positions (isolated). Size is risk-based, independent of this.
BITGET_LEVERAGE="10"
LIVE_TRADING_ENABLED="false"
# Bitget wallet capital, USDT — baseline for the "so với vốn" % on /bitget.
BITGET_INITIAL_CAPITAL_USD="100"

# --- MEXC futures (/mexc page) ---
# Real futures account. API permissions: the page needs "View Account Details" +
# "View Order Details" to read, and "Order Placing" to open/close/set TP-SL.
# Whitelist the server IP. MEXC has no passphrase — key + secret only.
# NOTE: futures order placement requires a KYC-verified account; MEXC's futures
# trading API was under maintenance from 2022-07-25 and reopened 2026-03-31.
MEXC_API_KEY=""
MEXC_API_SECRET=""
# Futures API host. MEXC moved it from contract.mexc.com on 2026-01-19 — override
# only if it moves again.
MEXC_API_BASE_URL="https://api.mexc.com"
# MEXC wallet capital, USDT — baseline for the "so với vốn" % on /mexc.
MEXC_INITIAL_CAPITAL_USD="100"

# --- DeepSeek agents (/deepseek page) ---
# OpenAI-compatible API (https://platform.deepseek.com). Without a key the page
# still renders but the Analyze button is disabled.
DEEPSEEK_API_KEY=""
# Hai tên cũ "deepseek-chat" / "deepseek-reasoner" đã bị khai tử 24/07/2026.
# "deepseek-v4-pro" = DeepSeek-V4-Pro-0813 (mặc định, bản GA 13/08/2026).
DEEPSEEK_MODEL="deepseek-v4-pro"
# Bản rẻ hơn — comment dòng trên lại và mở dòng này ra khi cần tiết kiệm.
# DEEPSEEK_MODEL="deepseek-v4-flash"
# Model nghĩ sâu tới đâu trước khi trả lời: "low" | "high" | "max" ("high" là mặc
# định của DeepSeek). Càng cao càng chậm và đắt; chain-of-thought hiện trong mục
# "Quá trình suy luận". Khi thinking bật thì temperature/top_p bị bỏ qua.
DEEPSEEK_REASONING_EFFORT="high"
# Override only for a proxy or a regional mirror.
DEEPSEEK_API_BASE_URL="https://api.deepseek.com"

# --- Cloudflare R2 image storage (POST /uploads/images) ---
# S3-compatible object storage. If any of these are unset, R2 uploads return a
# clear 503 and the rest of the app keeps running.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public bucket/custom-domain base URL, e.g. https://images.example.com (no trailing slash)
R2_PUBLIC_URL=""
